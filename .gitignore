.env
.env.local

# Home Assistant: allowlist, not a denylist. Everything HA writes into its
# bind mount stays out of git — the database, .storage credentials, secrets,
# UI-authored automations, media. Only configuration.yaml is versioned, which
# mirrors the rsync include/exclude in .github/workflows/deploy-rpi.yml.
# Listing files individually was fragile: anything HA started writing later
# (media/, image/, .cache/) silently fell through.
homeassistant/config/*
!homeassistant/config/configuration.yaml

setup-*.txt